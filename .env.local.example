# AI Engine — required for Phase 1 direct Gemini calls
GEMINI_API_KEY=your_key_from_aistudio.google.com

# Agent backend — set this to activate Phase 2 A.G.E.N.T. Loop™
# Leave blank to use Phase 1 direct Gemini fallback
AGENT_BACKEND_URL=http://localhost:8000

# Firebase — required for Phase 2 auth and Firestore persistence
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=varoai-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=varoai-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=varoai-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

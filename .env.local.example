# Copy this file to .env.local and fill in your values.
# Never commit .env.local to Git.

# AI Provider — 'claude' (default, recommended) or 'gemini'
AI_PROVIDER=claude

# Anthropic / Claude API key (get from console.anthropic.com)
ANTHROPIC_API_KEY=your_key_from_console.anthropic.com

# Gemini API key — only needed if AI_PROVIDER=gemini
GEMINI_API_KEY=your_key_from_aistudio.google.com

# Deployment mode — 'cloud' (Firebase) or 'onprem' (Docker/local)
DEPLOYMENT=cloud

# Optional: webhook authentication secret for /api/ingest/webhook
WEBHOOK_SECRET=

# Firebase (cloud deployment only)
NEXT_PUBLIC_FIREBASE_API_KEY=from_firebase_console
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=varoai-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=varoai-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=varoai-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
